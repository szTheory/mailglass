# Elixir build + dependency artifacts for the mailglass_inbound sibling package.
# The root .gitignore anchors its /_build//deps/ patterns to the repo root, so
# the sibling package needs its own. Generated by `mix deps.get` / `mix compile`.
/_build/
/cover/
/deps/
/doc/
/.fetch
erl_crash.dump
*.ez
*.beam
/config/*.secret.exs
.elixir_ls/
