defmodule MailglassAdmin.MixProject do
  use Mix.Project

  @version "0.1.0"

  def project do
    [
      app: :mailglass_admin,
      version: @version,
      deps: deps()
    ]
  end

  defp deps do
    [
      mailglass_dep()
    ]
  end

  defp mailglass_dep do
    if System.get_env("MIX_PUBLISH") == "true" do
      {:mailglass, "== 0.99.99"}
    else
      {:mailglass, path: "..", override: true}
    end
  end
end
