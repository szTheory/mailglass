{
  "$schema": "https://tokens.studio/schemas/tokens.json",
  "meta": {
    "name": "Mailglass Brand Tokens",
    "version": "1.0.0",
    "updated": "2026-06-05",
    "notes": "Source-control-friendly tokens for brand, docs, marketing, and lightweight UI examples. Product admin UI may map these into its own Tailwind/daisyUI layer."
  },
  "palette": {
    "ink": { "value": "#0D1B2A", "description": "Primary text, dark surfaces, code-adjacent structure" },
    "glass": { "value": "#277B96", "description": "Primary brand accent, links, selected states" },
    "ice": { "value": "#A6EAF2", "description": "Bright supporting accent, dark-surface highlight" },
    "mist": { "value": "#EAF6FB", "description": "Subtle surfaces and quiet panes" },
    "paper": { "value": "#F8FBFD", "description": "Primary light background" },
    "slate": { "value": "#5C6B7A", "description": "Secondary text, metadata, subdued structure" },
    "amber": { "value": "#A95F10", "description": "Warning and caution states" },
    "crimson": { "value": "#B42318", "description": "Error and destructive states" },
    "pine": { "value": "#166534", "description": "Success and healthy states" },
    "inkRaised": { "value": "#152538", "description": "Dark elevated surface" },
    "inkPressed": { "value": "#1F3049", "description": "Dark pressed/active surface" },
    "pineDark": { "value": "#8BB77F", "description": "Success on dark surfaces" },
    "amberDark": { "value": "#E0A955", "description": "Warning on dark surfaces" },
    "crimsonDark": { "value": "#D47368", "description": "Error on dark surfaces" }
  },
  "color": {
    "light": {
      "background": { "value": "{palette.paper.value}" },
      "surface": { "value": "{palette.paper.value}" },
      "surfaceSubtle": { "value": "{palette.mist.value}" },
      "surfaceRaised": { "value": "#FFFFFF" },
      "surfaceSelected": { "value": "#DDF2F7" },
      "border": { "value": "#C7DCE5" },
      "borderStrong": { "value": "{palette.glass.value}" },
      "text": { "value": "{palette.ink.value}" },
      "textMuted": { "value": "{palette.slate.value}" },
      "textInverse": { "value": "{palette.paper.value}" },
      "link": { "value": "{palette.glass.value}" },
      "linkHover": { "value": "#1D637A" },
      "accent": { "value": "{palette.glass.value}" },
      "accentSubtle": { "value": "{palette.mist.value}" },
      "focusRing": { "value": "{palette.glass.value}" }
    },
    "dark": {
      "background": { "value": "{palette.ink.value}" },
      "surface": { "value": "{palette.inkRaised.value}" },
      "surfaceSubtle": { "value": "{palette.inkPressed.value}" },
      "surfaceRaised": { "value": "#20354D" },
      "surfaceSelected": { "value": "#1B3E55" },
      "border": { "value": "#315069" },
      "borderStrong": { "value": "{palette.ice.value}" },
      "text": { "value": "{palette.mist.value}" },
      "textMuted": { "value": "#B8CAD4" },
      "textInverse": { "value": "{palette.ink.value}" },
      "link": { "value": "{palette.ice.value}" },
      "linkHover": { "value": "#D6F7FB" },
      "accent": { "value": "{palette.ice.value}" },
      "accentSubtle": { "value": "#153447" },
      "focusRing": { "value": "{palette.ice.value}" }
    },
    "state": {
      "default": { "value": "{palette.glass.value}" },
      "hover": { "value": "#1D637A" },
      "active": { "value": "#174E61" },
      "focus": { "value": "{palette.glass.value}" },
      "disabled": { "value": "#9AA8B4" },
      "selected": { "value": "#DDF2F7" },
      "success": { "value": "{palette.pine.value}" },
      "warning": { "value": "{palette.amber.value}" },
      "error": { "value": "{palette.crimson.value}" },
      "info": { "value": "{palette.glass.value}" },
      "subtle": { "value": "{palette.mist.value}" },
      "muted": { "value": "{palette.slate.value}" }
    },
    "callout": {
      "infoBackground": { "value": "#EAF6FB" },
      "infoBorder": { "value": "#277B96" },
      "successBackground": { "value": "#E8F3EA" },
      "successBorder": { "value": "#166534" },
      "warningBackground": { "value": "#FFF8F0" },
      "warningBorder": { "value": "#A95F10" },
      "errorBackground": { "value": "#FAE7E5" },
      "errorBorder": { "value": "#B42318" }
    },
    "code": {
      "background": { "value": "#0A1521" },
      "surface": { "value": "#101F2F" },
      "border": { "value": "#27435B" },
      "text": { "value": "#EAF6FB" },
      "muted": { "value": "#9EB6C4" },
      "accent": { "value": "#A6EAF2" },
      "string": { "value": "#8BB77F" },
      "warning": { "value": "#E0A955" },
      "error": { "value": "#D47368" }
    }
  },
  "typography": {
    "fontFamily": {
      "display": { "value": "\"Inter Tight\", \"Inter\", system-ui, -apple-system, sans-serif" },
      "ui": { "value": "\"Inter\", system-ui, -apple-system, sans-serif" },
      "mono": { "value": "\"IBM Plex Mono\", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace" }
    },
    "fontSize": {
      "label": { "value": "12px" },
      "small": { "value": "14px" },
      "body": { "value": "16px" },
      "lead": { "value": "18px" },
      "heading": { "value": "24px" },
      "display": { "value": "40px" }
    },
    "lineHeight": {
      "tight": { "value": "1.2" },
      "body": { "value": "1.5" },
      "loose": { "value": "1.65" }
    },
    "fontWeight": {
      "regular": { "value": "400" },
      "bold": { "value": "700" }
    },
    "letterSpacing": {
      "normal": { "value": "0" }
    }
  },
  "space": {
    "xs": { "value": "4px" },
    "sm": { "value": "8px" },
    "md": { "value": "16px" },
    "lg": { "value": "24px" },
    "xl": { "value": "32px" },
    "2xl": { "value": "48px" },
    "3xl": { "value": "64px" }
  },
  "radius": {
    "sm": { "value": "4px" },
    "md": { "value": "6px" },
    "lg": { "value": "8px" },
    "pill": { "value": "999px" }
  },
  "border": {
    "thin": { "value": "1px" },
    "thick": { "value": "2px" }
  },
  "shadow": {
    "flat": { "value": "none" },
    "raised": { "value": "0 1px 2px rgb(13 27 42 / 0.06)" },
    "overlay": { "value": "0 12px 32px -16px rgb(13 27 42 / 0.28)" }
  },
  "focus": {
    "width": { "value": "3px" },
    "offset": { "value": "2px" },
    "style": { "value": "solid" }
  },
  "motion": {
    "instant": { "value": "90ms" },
    "fast": { "value": "150ms" },
    "reveal": { "value": "220ms" },
    "max": { "value": "300ms" },
    "easeOut": { "value": "cubic-bezier(0.23, 1, 0.32, 1)" }
  }
}
