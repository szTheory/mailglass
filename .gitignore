# Elixir
/_build/
/cover/
/deps/
/doc/
/.fetch
erl_crash.dump
*.ez
*.beam
/config/*.secret.exs
.elixir_ls/

# Mix
/tmp/
/test/tmp/
/mailglass_admin/node_modules/
/mailglass_admin/test-results/
/mailglass_admin/playwright-report/
/reference/demo_app/tmp/
/reference/demo_app/assets/test-results/
/reference/demo_app/assets/playwright-report/
/mailglass-*.tar
/mailglass_admin/*.tar

# Local env overrides for the demo (see .env.example)
/.env

# Platform-specific standalone tailwind binaries — the Hex `tailwind` package
# downloads these into _build per-arch; they must never be committed.
/mailglass_admin/tailwind-macos-*
/mailglass_admin/tailwind-darwin-*
/mailglass_admin/tailwind-linux-*
/mailglass_admin/tailwind-windows-*

# macOS
.DS_Store
**/.DS_Store

# Persona-critic screenshot evidence cache (v1.14+). Screenshots are
# evidence-only attachments (PROJECT D-02), NOT a pixel-diff baseline. The gsd
# commit seam sweeps all dirty .planning/ paths, so the ~80-120 evidence PNGs
# the harness produces must be ignored. Scoped narrowly to the `.cache` dir so
# tracked sibling artifacts (DEFECT-REGISTER.md, story files, MILESTONE-SEED.md)
# stay tracked.
/.planning/research/**/.cache/

# GSD's phase lifecycle creates this advisory lock with volatile
# session/PID/timestamp metadata. Ignore only the canonical lock file so
# neighboring planning evidence remains visible to repository-truth checks.
/.planning/milestone.lock

# Local IDE/tooling — no project artifacts
/.claude/
/.bg-shell/
/.cursor/
/.gsd/*
!/.gsd/extensions/
/.gsd/extensions/*
!/.gsd/extensions/finalize-phase/
/.mcp.json
