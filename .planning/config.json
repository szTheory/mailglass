{
  "model_profile": "adaptive",
  "commit_docs": true,
  "parallelization": true,
  "search_gitignored": false,
  "brave_search": false,
  "firecrawl": false,
  "exa_search": false,
  "git": {
    "branching_strategy": "none",
    "allow_default_branch_commits": true,
    "phase_branch_template": "gsd/phase-{phase}-{slug}",
    "milestone_branch_template": "gsd/{milestone}-{slug}",
    "quick_branch_template": null
  },
  "workflow": {
    "test_command": "bash scripts/gsd-regression-gate.sh",
    "test_gate_timeout": 600,
    "research": true,
    "plan_check": true,
    "verifier": true,
    "nyquist_validation": true,
    "auto_advance": false,
    "node_repair": true,
    "node_repair_budget": 2,
    "ui_phase": true,
    "ui_safety_gate": true,
    "text_mode": false,
    "research_before_questions": true,
    "discuss_mode": "assumptions",
    "skip_discuss": false,
    "code_review": true,
    "code_review_depth": "standard",
    "_auto_chain_active": false,
    "ai_integration_phase": true,
    "use_worktrees": false
  },
  "hooks": {
    "context_warnings": true
  },
  "project_code": null,
  "phase_naming": "sequential",
  "agent_skills": {},
  "features": {},
  "preferences": {
    "vendor_philosophy": "opinionated",
    "milestone_discovery": {
      "research_first": true,
      "parallel_candidate_analysis": true,
      "ranking_lens": "adopter-jtbd-first",
      "done_lens": "adopter-value-not-perfectionism",
      "research_lens": "idiomatic-elixir-phoenix-ecto-plug; steal-from-successful-libs; DX/least-surprise-first",
      "repo_local_truth_first": true,
      "writeback_checklist": [
        "STATE.md",
        "threads",
        "milestone-candidate-note",
        "refresh-jtbd-coverage-if-stale"
      ]
    }
  },
  "mode": "yolo",
  "granularity": "standard",
  "model_profile_overrides": {
    "codex": {
      "opus": "gpt-6.1-sol",
      "sonnet": "gpt-6-luna",
      "haiku": "gpt-6-luna"
    },
    "claude": {
      "opus": "claude-opus-5-5",
      "sonnet": "claude-sonnet-5-5",
      "haiku": "claude-haiku-5-5"
    }
  },
  "runtime": "claude",
  "effort": {
    "routing_tier_defaults": {
      "light": "xhigh",
      "standard": "high",
      "heavy": "high"
    }
  }
}
