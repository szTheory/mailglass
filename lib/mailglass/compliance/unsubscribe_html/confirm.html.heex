<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Unsubscribe</title>
  </head>
  <body style="margin:0;background:#f8fbfd;color:#0d1b2a;font-family:Arial,sans-serif;">
    <main style="max-width:36rem;margin:4rem auto;padding:2rem;background:#ffffff;border:1px solid #d9e5ec;border-radius:16px;">
      <p style="margin:0 0 0.75rem;font-size:0.75rem;letter-spacing:0.08em;text-transform:uppercase;color:#5c6b7a;">
        Mailglass
      </p>
      <h1 style="margin:0 0 1rem;font-size:2rem;line-height:1.1;">Unsubscribe</h1>
      <p style="margin:0;font-size:1rem;line-height:1.6;">
        You are about to unsubscribe <strong><%= @recipient %></strong> from future email sent through this stream.
      </p>
    </main>
  </body>
</html>
