# mailglass demo — optional overrides for `make demo` / docker compose.
#
# You do NOT need this file. `make demo` works with zero setup using the
# defaults below. Copy it to `.env` only if you want to change ports or the
# reset token without typing them each run:
#
#   cp .env.example .env
#
# Docker Compose reads `.env` automatically. `.env` is gitignored.

# Host ports. Override these to run several library demos side by side without
# collisions. Convention: give each sibling lib its own band — mailglass owns
# 4015 (HTTP) / 5415 (Postgres); pick 4025/5425, 4035/5435, … for the others.
MAILGLASS_DEMO_HTTP_PORT=4015
MAILGLASS_DEMO_DB_PORT=5415

# Token guarding the demo's destructive data-reset endpoint. A dev placeholder
# is fine locally (the demo is loopback-bound). CI sets its own strong token.
DEMO_EVIDENCE_RESET_TOKEN=mailglass-dev-demo
