<!DOCTYPE html>
<html lang="en" data-theme={root_theme(assigns)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={Plug.CSRFProtection.get_csrf_token()} />
    <.live_title suffix=" · mailglass">
      {assigns[:page_title] || "Preview"}
    </.live_title>
    <link rel="icon" type="image/svg+xml" sizes="any" href={favicon_url(assigns)} />
    <link rel="stylesheet" href={css_url(assigns)} />
    <style>
      /* Until the local-time script marks a <time> localized, show a static, muted
         placeholder bar instead of the UTC fallback text — no shimmer (house style).
         Scoped to .mg-js so it only applies when JS is present to localize it. Brand
         tokens auto-adapt light/dark. */
      .mg-js time[data-local-time]:not([data-localized]) {
        display: inline-block;
        color: transparent;
        user-select: none;
        border-radius: var(--radius-field);
        background-color: var(--color-base-300);
      }
    </style>
    <script>
      <%= Phoenix.HTML.raw(js_inline()) %>
    </script>
  </head>
  <body>
    {@inner_content}
    <div
      id="mg-copy-toast"
      data-testid="copy-toast"
      class="toast toast-bottom toast-end mg-toast mg-layer-toast"
      role="status"
      aria-live="polite"
      aria-atomic="true"
      hidden
    >
      <div class="alert alert-success flex items-start gap-sm text-body">
        <span data-copy-toast-message></span>
      </div>
    </div>
  </body>
</html>
