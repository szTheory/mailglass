{
  "meta": {
    "name": "mailglass brand tokens",
    "notes": "Two tiers: palette holds the raw brand values; color, font, text, space, radius, and focus hold the semantic roles that pages reference. Color values are hex strings and dimensions are px strings, with an upgrade path to structured value objects if tooling ever consumes this file. tokens.css carries the same values as CSS custom properties."
  },
  "palette": {
    "$type": "color",
    "ink": { "$value": "#0D1B2A", "$description": "Near-navy core dark; primary text on light, base surface on dark" },
    "ink-raised": { "$value": "#152538", "$description": "Dark card surface, one step above ink" },
    "ink-overlay": { "$value": "#1F3049", "$description": "Dark modal and pressed surface" },
    "ink-sunken": { "$value": "#0A1521", "$description": "Dark code wells and recessed panels" },
    "ink-selected": { "$value": "#1B3E55", "$description": "Dark selected-row surface" },
    "ink-edge": { "$value": "#315069", "$description": "Dark decorative hairline; never a control boundary" },
    "glass": { "$value": "#277B96", "$description": "Brand teal; icons, strong borders, focus rings, large text, solid fills" },
    "glass-deep": { "$value": "#1D637A", "$description": "Text-safe teal for links and accent text on any light surface" },
    "glass-deepest": { "$value": "#174E61", "$description": "Darkest teal; link hover and active states" },
    "ice": { "$value": "#A6EAF2", "$description": "Pale cyan; dark-theme accent and link color" },
    "ice-bright": { "$value": "#D6F7FB", "$description": "Brightest cyan; dark-theme link hover" },
    "ice-tint": { "$value": "#DDF2F7", "$description": "Light selected-row surface" },
    "ice-shadow": { "$value": "#11293A", "$description": "Dark info callout surface" },
    "mist": { "$value": "#EAF6FB", "$description": "Pale blue tint; light sunken surfaces, dark-theme body text" },
    "mist-soft": { "$value": "#B8CAD4", "$description": "Muted blue-gray; dark-theme secondary text" },
    "mist-edge": { "$value": "#C7DCE5", "$description": "Light decorative hairline; never a control boundary" },
    "paper": { "$value": "#F8FBFD", "$description": "Light page background" },
    "white": { "$value": "#FFFFFF", "$description": "Light card surface; text on dark solid fills" },
    "slate": { "$value": "#5C6B7A", "$description": "Blue-gray; light secondary text and strong borders" },
    "slate-soft": { "$value": "#74909F", "$description": "Light input-border gray; holds 3:1 on light surfaces" },
    "slate-bright": { "$value": "#62809A", "$description": "Dark input-border gray; holds 3:1 on dark surfaces" },
    "slate-dim": { "$value": "#6B7E8F", "$description": "Dark disabled text" },
    "slate-faint": { "$value": "#9AA8B4", "$description": "Light disabled text" },
    "pine": { "$value": "#166534", "$description": "Success green; light text, borders, solid fills" },
    "pine-bright": { "$value": "#8BB77F", "$description": "Success green for dark-theme text and fills" },
    "pine-tint": { "$value": "#E8F3EA", "$description": "Light success callout surface" },
    "pine-shadow": { "$value": "#142B22", "$description": "Dark success callout surface" },
    "amber": { "$value": "#A95F10", "$description": "Warning orange; light borders, icons, solid fills" },
    "amber-deep": { "$value": "#96520E", "$description": "Warning text that holds 4.5:1 on every light surface" },
    "amber-bright": { "$value": "#E0A955", "$description": "Warning orange for dark-theme text and fills" },
    "amber-tint": { "$value": "#FFF8F0", "$description": "Light warning callout surface" },
    "amber-shadow": { "$value": "#2B2314", "$description": "Dark warning callout surface" },
    "crimson": { "$value": "#B42318", "$description": "Error red; light text, borders, solid fills" },
    "crimson-bright": { "$value": "#E29089", "$description": "Error red that holds 4.5:1 on every dark surface" },
    "crimson-tint": { "$value": "#FAE7E5", "$description": "Light error callout surface" },
    "crimson-shadow": { "$value": "#2E1B1E", "$description": "Dark error callout surface" }
  },
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "{palette.paper}", "$description": "Page background" },
      "surface": { "$value": "{palette.white}", "$description": "Default card and panel surface" },
      "surface-raised": { "$value": "{palette.white}", "$description": "Elevated cards; pair with shadow or border" },
      "surface-overlay": { "$value": "{palette.white}", "$description": "Modals, menus, popovers" },
      "surface-sunken": { "$value": "{palette.mist}", "$description": "Code wells and recessed panels" },
      "surface-selected": { "$value": "{palette.ice-tint}", "$description": "Selected rows and active nav items" },
      "border": { "$value": "{palette.mist-edge}", "$description": "Decorative dividers and hairlines only" },
      "border-input": { "$value": "{palette.slate-soft}", "$description": "Form-control boundaries; 3:1 verified" },
      "border-strong": { "$value": "{palette.slate}", "$description": "Emphasis borders" },
      "text": { "$value": "{palette.ink}", "$description": "Body and heading text" },
      "text-muted": { "$value": "{palette.slate}", "$description": "Secondary text; AA only — use text where AAA matters" },
      "text-disabled": { "$value": "{palette.slate-faint}", "$description": "Disabled controls; never the only signal" },
      "text-inverse": { "$value": "{palette.white}", "$description": "Text on dark or solid fills" },
      "accent": { "$value": "{palette.glass}", "$description": "Icons, strong borders, large text, solid fills — never body text on tinted surfaces" },
      "accent-text": { "$value": "{palette.glass-deep}", "$description": "Accent text safe on every light surface including tinted callouts" },
      "link": { "$value": "{palette.glass-deep}", "$description": "Link text on any light surface" },
      "link-hover": { "$value": "{palette.glass-deepest}", "$description": "Hovered links; contrast rises on hover" },
      "link-active": { "$value": "{palette.glass-deepest}", "$description": "Pressed links" },
      "focus-ring": { "$value": "{palette.glass}", "$description": "Focus outline on every surface" },
      "success-text": { "$value": "{palette.pine}", "$description": "Success copy on page and callout surfaces" },
      "success-bg": { "$value": "{palette.pine-tint}", "$description": "Success callout surface" },
      "success-border": { "$value": "{palette.pine}", "$description": "Success callout border" },
      "success-solid": { "$value": "{palette.pine}", "$description": "Solid success fill" },
      "success-on-solid": { "$value": "{palette.white}", "$description": "Text on solid success fill" },
      "warning-text": { "$value": "{palette.amber-deep}", "$description": "Warning copy on page and callout surfaces" },
      "warning-bg": { "$value": "{palette.amber-tint}", "$description": "Warning callout surface" },
      "warning-border": { "$value": "{palette.amber}", "$description": "Warning callout border" },
      "warning-solid": { "$value": "{palette.amber}", "$description": "Solid warning fill" },
      "warning-on-solid": { "$value": "{palette.white}", "$description": "Text on solid warning fill" },
      "error-text": { "$value": "{palette.crimson}", "$description": "Error copy on page and callout surfaces" },
      "error-bg": { "$value": "{palette.crimson-tint}", "$description": "Error callout surface" },
      "error-border": { "$value": "{palette.crimson}", "$description": "Error callout border" },
      "error-solid": { "$value": "{palette.crimson}", "$description": "Solid error fill" },
      "error-on-solid": { "$value": "{palette.white}", "$description": "Text on solid error fill" },
      "info-text": { "$value": "{palette.glass-deep}", "$description": "Info copy; the brand teal itself is not text-safe here" },
      "info-bg": { "$value": "{palette.mist}", "$description": "Info callout surface" },
      "info-border": { "$value": "{palette.glass}", "$description": "Info callout border" },
      "info-solid": { "$value": "{palette.glass-deep}", "$description": "Solid info fill" },
      "info-on-solid": { "$value": "{palette.white}", "$description": "Text on solid info fill" }
    },
    "dark": {
      "background": { "$value": "{palette.ink}", "$description": "Page background" },
      "surface": { "$value": "{palette.ink}", "$description": "Default card and panel surface" },
      "surface-raised": { "$value": "{palette.ink-raised}", "$description": "Elevated cards" },
      "surface-overlay": { "$value": "{palette.ink-overlay}", "$description": "Modals, menus, popovers" },
      "surface-sunken": { "$value": "{palette.ink-sunken}", "$description": "Code wells and recessed panels" },
      "surface-selected": { "$value": "{palette.ink-selected}", "$description": "Selected rows and active nav items" },
      "border": { "$value": "{palette.ink-edge}", "$description": "Decorative dividers and hairlines only" },
      "border-input": { "$value": "{palette.slate-bright}", "$description": "Form-control boundaries; 3:1 verified" },
      "border-strong": { "$value": "{palette.slate-bright}", "$description": "Emphasis borders" },
      "text": { "$value": "{palette.mist}", "$description": "Body and heading text; AAA on every dark surface" },
      "text-muted": { "$value": "{palette.mist-soft}", "$description": "Secondary text; AAA on every dark surface" },
      "text-disabled": { "$value": "{palette.slate-dim}", "$description": "Disabled controls; never the only signal" },
      "text-inverse": { "$value": "{palette.ink}", "$description": "Text on light or bright solid fills" },
      "accent": { "$value": "{palette.ice}", "$description": "Icons, borders, fills; the dark-theme accent is ice, not teal" },
      "accent-text": { "$value": "{palette.ice}", "$description": "Accent text safe on every dark surface" },
      "link": { "$value": "{palette.ice}", "$description": "Link text on any dark surface" },
      "link-hover": { "$value": "{palette.ice-bright}", "$description": "Hovered links; contrast rises on hover" },
      "link-active": { "$value": "{palette.ice-bright}", "$description": "Pressed links" },
      "focus-ring": { "$value": "{palette.ice}", "$description": "Focus outline on every surface" },
      "success-text": { "$value": "{palette.pine-bright}", "$description": "Success copy on page and callout surfaces" },
      "success-bg": { "$value": "{palette.pine-shadow}", "$description": "Success callout surface" },
      "success-border": { "$value": "{palette.pine-bright}", "$description": "Success callout border" },
      "success-solid": { "$value": "{palette.pine-bright}", "$description": "Solid success fill" },
      "success-on-solid": { "$value": "{palette.ink}", "$description": "Text on solid success fill" },
      "warning-text": { "$value": "{palette.amber-bright}", "$description": "Warning copy on page and callout surfaces" },
      "warning-bg": { "$value": "{palette.amber-shadow}", "$description": "Warning callout surface" },
      "warning-border": { "$value": "{palette.amber-bright}", "$description": "Warning callout border" },
      "warning-solid": { "$value": "{palette.amber-bright}", "$description": "Solid warning fill" },
      "warning-on-solid": { "$value": "{palette.ink}", "$description": "Text on solid warning fill" },
      "error-text": { "$value": "{palette.crimson-bright}", "$description": "Error copy safe on every dark surface" },
      "error-bg": { "$value": "{palette.crimson-shadow}", "$description": "Error callout surface" },
      "error-border": { "$value": "{palette.crimson-bright}", "$description": "Error callout border" },
      "error-solid": { "$value": "{palette.crimson-bright}", "$description": "Solid error fill" },
      "error-on-solid": { "$value": "{palette.ink}", "$description": "Text on solid error fill" },
      "info-text": { "$value": "{palette.ice}", "$description": "Info copy on page and callout surfaces" },
      "info-bg": { "$value": "{palette.ice-shadow}", "$description": "Info callout surface" },
      "info-border": { "$value": "{palette.ice}", "$description": "Info callout border" },
      "info-solid": { "$value": "{palette.ice}", "$description": "Solid info fill" },
      "info-on-solid": { "$value": "{palette.ink}", "$description": "Text on solid info fill" }
    }
  },
  "font": {
    "$type": "fontFamily",
    "display": { "$value": "\"Inter Tight\", Inter, system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", sans-serif", "$description": "Headlines and large numerals; most viewers see the system fallback" },
    "ui": { "$value": "Inter, system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", sans-serif", "$description": "Body and interface text; most viewers see the system fallback" },
    "mono": { "$value": "\"IBM Plex Mono\", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace", "$description": "Code, tokens, labels" }
  },
  "text": {
    "$type": "dimension",
    "display": { "$value": "44px", "$description": "Hero headlines" },
    "h1": { "$value": "36px", "$description": "Page titles" },
    "h2": { "$value": "30px", "$description": "Section headings" },
    "h3": { "$value": "24px", "$description": "Subsection headings" },
    "body": { "$value": "16px", "$description": "Body copy" },
    "small": { "$value": "14px", "$description": "Captions and secondary copy" },
    "code": { "$value": "14px", "$description": "Code and inline tokens" }
  },
  "space": {
    "$type": "dimension",
    "xs": { "$value": "4px" },
    "sm": { "$value": "8px" },
    "md": { "$value": "16px" },
    "lg": { "$value": "24px" },
    "xl": { "$value": "40px" },
    "2xl": { "$value": "64px" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "4px" },
    "md": { "$value": "8px" },
    "lg": { "$value": "12px" },
    "full": { "$value": "9999px" }
  },
  "focus": {
    "$type": "dimension",
    "ring-width": { "$value": "2px" },
    "ring-offset": { "$value": "2px" }
  }
}
